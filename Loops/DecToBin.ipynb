   ],
   "source": [
    "dec = int(input(\"Enter the decimal number: \"))\n",
    "\n",
    "Bin = 0\n",
    "time = 0\n",
    "num = dec\n",
    "while(num!=0):\n",
    "    binDig = num%2\n",
    "    Bin += binDig * (10**time)\n",
    "    num = num//2\n",
    "    time+=1\n",
    "\n",
    "print(dec, \"in Binary is\",  Bin)"
   ]
