   ],
   "source": [
    "Bin = int(input(\"Enter the binary number: \"))\n",
    "\n",
    "i=0\n",
    "b = Bin\n",
    "dec = 0\n",
    "while(b!=0):\n",
    "    digit = b%10\n",
    "    dec += digit*(2**i)\n",
    "    b = b//10\n",
    "    i+=1\n",
    "\n",
    "print(Bin, \"in decimal is\", dec)"
   ]
